# Base URL of the cutmax-backend API. Used both server-side (server components/route
# handlers) and exposed to the browser (NEXT_PUBLIC_ prefix) since the frontend calls
# the backend directly with credentials, from both server and client contexts.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# This site's own public URL — used to resolve absolute OG/Twitter image URLs and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Only needed if cutmax-backend runs with STORAGE_DRIVER=s3 — same value as its
# S3_PUBLIC_BASE_URL, so next/image is allowed to optimize R2-hosted images.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=""

NODE_ENV="development"
